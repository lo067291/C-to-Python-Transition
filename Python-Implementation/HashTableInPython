TABLE_SIZE = 10


class Entry:
    def __init__(self, key, value):
        self.key = key
        self.value = value
        self.next = None


class HashTable:
    def __init__(self):
        self.buckets = [None] * TABLE_SIZE

    def _hash(self, key):
        hash_value = 0
        for char in key:
            hash_value = (hash_value * 31) + ord(char)
        return hash_value % TABLE_SIZE

    def insert(self, key, value):
        index = self._hash(key)
        new_entry = Entry(key, value)
        new_entry.next = self.buckets[index]
        self.buckets[index] = new_entry

    def get(self, key):
        index = self._hash(key)
        entry = self.buckets[index]

        while entry is not None:
            if entry.key == key:
                return entry.value
            entry = entry.next

        print("Key not found")
        return None


if __name__ == "__main__":
    table = HashTable()
    table.insert("apple", 5)
    table.insert("banana", 12)
    table.insert("cherry", 8)

    print(f"apple: {table.get('apple')}")
    print(f"banana: {table.get('banana')}")
    print(f"cherry: {table.get('cherry')}")

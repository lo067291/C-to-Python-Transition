class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class Stack:
    def __init__(self):
        self.top = None

    def push(self, value):
        new_node = Node(value)
        new_node.next = self.top
        self.top = new_node

    def pop(self):
        if self.top is None:
            print("Stack underflow")
            return None
        value = self.top.data
        self.top = self.top.next
        return value

    def peek(self):
        if self.top is None:
            print("Stack is empty")
            return None
        return self.top.data

    def is_empty(self):
        return self.top is None


if __name__ == "__main__":
    s = Stack()
    s.push(10)
    s.push(20)
    s.push(30)

    print(f"Top: {s.peek()}")
    print(f"Popped: {s.pop()}")
    print(f"Popped: {s.pop()}")
    print(f"Is empty: {s.is_empty()}")
